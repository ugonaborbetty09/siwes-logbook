# ─── Core Django ──────────────────────────────────────────────────────────────
# Generate a real secret key: python -c "from django.core.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Email — Production (SMTP enabled by default) ────────────────────────────
# Fill in your real provider credentials here to send real emails.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=SIWES Logbook Manager <your-gmail-address@gmail.com>

# ─── Resend HTTPS email delivery (recommended on Render) ──────────────────────
# Create an API key at https://resend.com/api-keys
# Use onboarding@resend.dev for testing, or a sender from your verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SIWES Logbook Manager <onboarding@resend.dev>

# ─── Optional: use the console backend for local testing only ─────────────────
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ─── Alternative: Brevo (formerly Sendinblue) — Free 300 emails/day ───────────
# Sign up at https://www.brevo.com (free tier)
# Get SMTP credentials from Settings > SMTP & API
#
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-brevo-login-email@example.com
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# DEFAULT_FROM_EMAIL=SIWES Logbook Manager <your-sender@example.com>
